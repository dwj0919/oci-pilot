# 复制为 .env 或直接 export
# 【必填】Telegram Bot Token —— 面板登录唯一方式就是 Telegram 验证码,
# 不配这个 Bot 就起不来, 谁也登录不了。
# 找 @BotFather 创建机器人获取。
TELEGRAM_BOT_TOKEN=
# 【必填】允许使用 Bot 的 Telegram 数字 ID 白名单(逗号分隔)
# 为空则 Bot 拒绝所有人, 等于谁也登录不了。
# 给 @userinfobot 发任意消息可查到自己的数字 ID
TELEGRAM_ALLOWED_IDS=

# 面板端口
OCI_PILOT_PORT=9528

# 数据目录 (SQLite + 加密密钥都存在这里)
OCI_PILOT_DATA=./data

# 登录 token 有效期(小时)
JWT_EXPIRE_HOURS=72
