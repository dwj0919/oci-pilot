# 复制为 .env 或直接 export
# Telegram Bot Token (可选, 不填则 Bot 不启动)
TELEGRAM_BOT_TOKEN=
# 允许使用 Bot 的 Telegram 数字 ID 白名单(逗号分隔, 为空则拒绝所有人)
# 给 @userinfobot 发任意消息可查到自己的数字 ID
TELEGRAM_ALLOWED_IDS=

# 面板端口
OCI_PILOT_PORT=9528

# 数据目录 (SQLite + 加密密钥都存在这里)
OCI_PILOT_DATA=./data

# 登录 token 有效期(小时)
JWT_EXPIRE_HOURS=72
